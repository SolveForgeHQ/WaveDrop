{
  "name": "@wavedrop/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WaveDrop API server — Fastify + Prisma",
  "scripts": {
    "dev":       "tsx watch src/index.ts",
    "build":     "tsc --project tsconfig.build.json",
    "postbuild": "prisma generate",
    "start":     "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate":  "prisma migrate dev",
    "prisma:studio":   "prisma studio",
    "db:seed":         "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/oauth2": "^8.1.0",
    "@fastify/session": "^11.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@wavedrop/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.0.1",
    "js-sha3": "^0.9.3",
    "merkletreejs": "^0.4.0",
    "pg": "^8.13.3",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
