{
  "compilerOptions": {
    "target":                   "ES2022",
    "module":                   "nodenext",
    "moduleResolution":         "nodenext",
    "lib":                      ["ES2022"],
    "outDir":                   "./dist",
    "rootDir":                  "./src",
    "strict":                   true,
    "skipLibCheck":              true,
    "verbatimModuleSyntax":     true,
    "isolatedModules":          true,
    "noUncheckedIndexedAccess": true,
    "types":                    ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
