# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/wavedrop"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ── CORS / session ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Must be at least 32 characters — change before deploying
SESSION_SECRET=change-this-to-a-long-random-string-min-32-chars

# ── GitHub OAuth (create at https://github.com/settings/developers) ─────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the callback URL set in your GitHub OAuth App settings
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated GitHub logins that have admin privileges
ADMIN_GITHUB_LOGINS=your-github-login

# ── Avalanche ────────────────────────────────────────────────────────────────
# Fuji testnet for dev; swap to mainnet RPC for production
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Private key for the settlement operator (used by the on-chain submit script)
# NEVER commit a real private key — use a secrets manager in production
SETTLEMENT_PRIVATE_KEY=0x...

# Deployed contract addresses (filled in after running forge script Deploy.s.sol)
REGISTRY_ADDRESS=
MERKLE_CLAIM_ADDRESS=

# ── GitHub App (webhook handler) ─────────────────────────────────────────────
# Create at https://github.com/settings/apps
GITHUB_APP_ID=
# Multi-line PEM key — use \n to encode newlines in a single-line env var
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Port the webhook server listens on (separate from the main API on 4000)
GITHUB_WEBHOOK_PORT=4001

# ── PR staleness cutoff ───────────────────────────────────────────────────────
# PRs opened before this date won't earn points (set to wave start date)
PR_CUTOFF_DATE=2025-01-01T00:00:00Z

# ── Snowtrace (contract verification) ────────────────────────────────────────
SNOWTRACE_API_KEY=
