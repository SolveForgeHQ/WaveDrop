# ─────────────────────────────────────────────────────────────────────────────
# WaveDrop Backend — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Local Docker (matches docker-compose.yml):
DATABASE_URL="postgresql://wavedrop:wavedrop@localhost:5432/wavedrop"
# Neon (production):
# DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/wavedrop?sslmode=require"

# ── Session ───────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-secure-random-string-min-32-chars!!"

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
GITHUB_CALLBACK_URL="http://localhost:4000/auth/github/callback"

# ── GitHub App (webhook integration) ─────────────────────────────────────────
# Create at: https://github.com/settings/apps
GITHUB_APP_ID="your_github_app_id"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your_webhook_secret"

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
PORT="4000"

# ── Admin logins (comma-separated GitHub usernames) ───────────────────────────
ADMIN_GITHUB_LOGINS="your_github_username"

# ── Stellar / Soroban (settlement layer) ─────────────────────────────────────
# Network: mainnet | testnet | futurenet
STELLAR_NETWORK="testnet"
# Your operator Stellar secret key (for submitting Merkle roots on-chain)
STELLAR_OPERATOR_SECRET="S..."
# Deployed WaveDrop Soroban contract ID (fill after deployment)
WAVEDROP_CONTRACT_ID=""

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
NODE_ENV="development"
