# Address that signs the broadcast transaction (must match --account or PRIVATE_KEY)
DEPLOYER_ADDRESS=0x

# Backend signer that receives OPERATOR_ROLE on WaveRegistry and MerkleClaim
OPERATOR_ADDRESS=0x

# Set to true on Fuji testnet (deploys MockERC20); false on mainnet
DEPLOY_MOCK_USDC=true

# Required only when DEPLOY_MOCK_USDC=false
# Avalanche C-Chain mainnet USDC: 0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6c
USDC_ADDRESS=

# Contract verification
SNOWTRACE_API_KEY=

# Populated after deployment — paste into backend/.env
REGISTRY_ADDRESS=
MERKLE_CLAIM_ADDRESS=
